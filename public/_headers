# As the PWA: no framing (the sign-in form takes passwords), no MIME sniffing.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Apple reads the association file as JSON; it has no extension to say so.
/.well-known/apple-app-site-association
  Content-Type: application/json

# The app's version gate (update gate) reads this; a raised minimum reaches every app within minutes.
/app-config.json
  Content-Type: application/json
  Cache-Control: public, max-age=300

# As the PWA: hashed bundles forever, the shell and the service worker never stale.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
